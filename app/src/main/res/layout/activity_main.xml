<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/titulo_resumen"
            android:textColor="@color/azul_institucional"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textoTotal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/verde_institucional"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/campoConcepto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/hint_concepto"
            android:importantForAutofill="no"
            android:inputType="textCapSentences"
            android:maxLines="1" />

        <Spinner
            android:id="@+id/listaCategorias"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp" />

        <EditText
            android:id="@+id/campoMonto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_monto"
            android:importantForAutofill="no"
            android:inputType="numberDecimal"
            android:maxLines="1" />

        <TextView
            android:id="@+id/textoMensaje"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="14sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/botonAgregar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/verde_institucional"
            android:text="@string/boton_agregar"
            android:textColor="#FFFFFF" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/botonPastel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:backgroundTint="@color/azul_institucional"
                android:text="@string/boton_pastel"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/botonBarras"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:backgroundTint="@color/azul_institucional"
                android:text="@string/boton_barras"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <com.github.mikephil.charting.charts.PieChart
            android:id="@+id/graficaPastel"
            android:layout_width="match_parent"
            android:layout_height="220dp" />

        <com.github.mikephil.charting.charts.BarChart
            android:id="@+id/graficaBarras"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
